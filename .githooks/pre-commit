#!/usr/bin/env python3
import subprocess
import sys

commands = (
    [sys.executable, "scripts/check_version_bump.py", "--staged"],
    # Runs here as well as in CI: the check is about what the *other* AI clients see.
    [sys.executable, "scripts/check_agent_instructions.py"],
)

for cmd in commands:
    result = subprocess.run(cmd)
    if result.returncode != 0:
        print(f"Fix and rerun: {' '.join(cmd)}", file=sys.stderr)
        sys.exit(result.returncode)

sys.exit(0)
